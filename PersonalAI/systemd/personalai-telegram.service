[Unit]
Description=PersonalAI Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=personalai
Group=personalai
WorkingDirectory=/opt/personalai/PersonalAI
Environment="PATH=/opt/personalai/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"

# Start command
ExecStart=/opt/personalai/venv/bin/python main.py telegram

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=200
StartLimitBurst=5

# Resource limits
LimitNOFILE=65536
MemoryMax=16G
CPUQuota=400%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=personalai-telegram

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/personalai/PersonalAI/data
ReadWritePaths=/opt/personalai/result

[Install]
WantedBy=multi-user.target
