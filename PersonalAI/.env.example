# PersonalAI Environment Variables
# Kopieer dit bestand naar .env en vul je eigen waarden in

# Telegram Bot Token (krijg van @BotFather op Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Toegang (optioneel - laat leeg voor iedereen)
# Comma-separated lijst van user IDs
TELEGRAM_ALLOWED_USERS=

# OpenAI API Key (optioneel - voor toekomstige features)
OPENAI_API_KEY=

# Anthropic API Key (optioneel - voor toekomstige features)
ANTHROPIC_API_KEY=
